function reverse(str){
    
    let ans = "";

    for(let i = str.length-1; i>=0; i--){
        ans += str[i];
    }
    return ans;
}

// More Optimized...........

function reverseWords(str) {

    return str
        .trim()
        .split(/\s+/)
        .reverse()
        .join(" ");
}

